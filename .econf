%% -*- Erlang -*-
%%
%% Example config file.  user_default reads the file .econf in the
%% directory where Erlang is started.
%%
%% Each term is {Key, Value}.  If a key occurs more than once, the
%% last value is used.

%% mk() runs make in these directories
{mkdir, [".",
         "../erlang-opprec",
         "../erlang-lex"]}.

%% These directories are added to the code path at startup
{ebin, ["../erlang-opprec/ebin",
        "../erlang-lex/ebin",
        "../erlang-repl-utils/",
        "./ebin"]}.
